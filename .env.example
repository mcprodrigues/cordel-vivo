# Copy to .env and fill in. .env is never committed.
# Values here are for local development only.

# Postgres (infra/docker-compose.yml)
CORDEL_POSTGRES_DB=cordel
CORDEL_POSTGRES_USER=cordel
CORDEL_POSTGRES_PASSWORD=change-me
# Host port; 55450 avoids ports already used by other local projects.
CORDEL_POSTGRES_PORT=55450

# S3-compatible storage, SeaweedFS (infra/docker-compose.yml)
CORDEL_S3_ACCESS_KEY=cordel
CORDEL_S3_SECRET_KEY=change-me
CORDEL_S3_PORT=58333

# Database tests (pytest -m db) connect here; must match the values above.
CORDEL_DB_URL=postgresql://cordel:change-me@127.0.0.1:55450/cordel

# API. Comma-separated keys; the API refuses to start without one.
CORDEL_API_KEYS=change-me
CORDEL_API_HOST=127.0.0.1
# Host port; 8010 avoids ports already used by other local projects.
CORDEL_API_PORT=8010
